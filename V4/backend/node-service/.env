# Environment Configuration
NODE_ENV=development
PORT=8181

# Database Configuration
DB_TYPE=sqlite
DB_PATH=../data/copilot_prompter.db
DB_LOGGING=false

# Alternative Database Configurations (commented out)
# MySQL Configuration
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=copilot_prompter
# DB_USER=root
# DB_PASSWORD=password

# PostgreSQL Configuration
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=copilot_prompter
# DB_USER=postgres
# DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=YourVerySecretKeyThatShouldBeAtLeast32CharactersLongForSecurity
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:4200,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Application Configuration
APP_NAME=Copilot Prompter Node Service
APP_VERSION=1.0.0

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api/docs
